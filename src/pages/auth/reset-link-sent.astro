---
import Layout from "@/layouts/Layout.astro";
import ResendCooldown from "@/components/auth/ResendCooldown";
---

<Layout title="Check your email">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div
      class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl"
    >
      <div class="mb-4 text-5xl">📧</div>
      <h1 class="mb-3 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        Check your email
      </h1>
      <p class="mb-6 text-blue-100/80">
        If an account exists for that email, we've sent a link to reset your password.
      </p>
      <ResendCooldown client:load />
      <p class="mt-4 text-sm text-blue-100/60">
        <a href="/auth/signin" class="text-purple-300 hover:underline">Back to sign in</a>
      </p>
    </div>
  </div>
</Layout>
