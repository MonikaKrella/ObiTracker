---
import AuthLayout from "@/layouts/AuthLayout.astro";
import { createClient } from "@/lib/supabase";
import { getDogsList } from "@/lib/services/dogs";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const dogs = supabase ? await getDogsList(supabase) : [];
---

<AuthLayout title="Add dog" dogs={dogs}>
  <div class="mx-auto max-w-md">
    <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
      Add a dog
    </h1>
    <!-- AddDogForm React island mounted here in Phase 3 -->
    <div data-add-dog-form class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
      <p class="text-center text-sm text-blue-100/40">Form coming soon…</p>
    </div>
  </div>
</AuthLayout>
