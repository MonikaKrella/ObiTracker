---
import AuthLayout from "@/layouts/AuthLayout.astro";
import { createClient } from "@/lib/supabase";
import { getDogsList } from "@/lib/services/dogs";
import { loadCompetitionBoard } from "@/lib/services/competition-board";
import type { CompetitionTimeWindow } from "@/lib/dates";
import { CompetitionResultsGrid } from "@/components/competition-results/CompetitionResultsGrid";
import {
  COMPETITION_WINDOW_COOKIE_NAME,
  isCompetitionTimeWindow,
} from "@/components/competition-results/window-options";
import { COMPETITION_CLASSES } from "@/const";
import type { Competition, CompetitionScore, Exercise } from "@/types";

// selectedDog is guaranteed non-null by middleware: it redirects to /dashboard
// if the dog is not found, soft-deleted, or owned by another user.
// The null guard below is a defensive fallback for TypeScript's benefit.
const { selectedDog } = Astro.locals;
if (!selectedDog) {
  return Astro.redirect("/dashboard");
}

// The display selector is persisted as a cookie (not localStorage) specifically
// so it can be resolved here, server-side, and rendered correctly on the very
// first paint — mirrors grid.astro's 7/14/30 window cookie.
const rawWindow = Astro.cookies.get(COMPETITION_WINDOW_COOKIE_NAME)?.value ?? "";
const initialWindow: CompetitionTimeWindow = isCompetitionTimeWindow(rawWindow) ? rawWindow : "all-time";

const supabase = createClient(Astro.request.headers, Astro.cookies);
let serviceUnavailable = !supabase;
const dogs = supabase ? await getDogsList(supabase) : [];

let exercises: Exercise[] = [];
let competitions: Competition[] = [];
let scores: Pick<CompetitionScore, "competition_id" | "exercise_id" | "score">[] = [];
const markedDefaultClass = COMPETITION_CLASSES.find((c) => c.class_number === selectedDog.default_class_number);
const lastClass = COMPETITION_CLASSES.find((c) => c.sort_position === 3);
const defaultClass = markedDefaultClass ?? lastClass;
const requestedClassNumber = Number(Astro.url.searchParams.get("classNumber"));
const requestedClass = COMPETITION_CLASSES.find((c) => c.class_number === requestedClassNumber);
const selectedClassNumber = (requestedClass ?? defaultClass)?.class_number ?? 3;

if (supabase) {
  try {
    // Always fetch the "all-time" superset here — independent of the
    // cookie-persisted display window — so the client-side window selector
    // (CompetitionResultsGrid.tsx) can filter columns/averages/highlights
    // without an extra round trip, mirroring how grid.astro always fetches
    // its fixed 30-day window regardless of the 7/14/30 display selector.
    // The returned `board` is discarded — its averages()/highlights() are
    // not passed as props; CompetitionResultsGrid.tsx recomputes its own
    // copy client-side (see plan.md "What We're NOT Doing"). Calling
    // loadCompetitionBoard still gets us its fail-fast validation of the
    // fetched rows before rendering.
    ({ exercises, competitions, scores } = await loadCompetitionBoard(
      supabase,
      selectedDog.id,
      selectedClassNumber,
      "all-time",
    ));
  } catch {
    serviceUnavailable = true;
  }
}
---

<AuthLayout title={`${selectedDog.name} – Competition results`} dogs={dogs}>
  <div class="space-y-6">
    <a
      href={`/dogs/${selectedDog.id}/dashboard`}
      class="text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline"
    >
      ← Back to {selectedDog.name}'s dashboard
    </a>

    <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
      Competition results
    </h1>

    <!-- Full-bleed break-out — see grid.astro for the identical rationale. -->
    <div class="mx-[calc(50%-50vw)] px-4 lg:px-8">
      <CompetitionResultsGrid
        client:load
        dogId={selectedDog.id}
        dogName={selectedDog.name}
        exercises={exercises}
        competitions={competitions}
        scores={scores}
        selectedClassNumber={selectedClassNumber}
        dogDefaultClassNumber={selectedDog.default_class_number}
        initialWindow={initialWindow}
        serviceUnavailable={serviceUnavailable}
      />
    </div>
  </div>
</AuthLayout>
